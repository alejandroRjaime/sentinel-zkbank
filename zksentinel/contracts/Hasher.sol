pragma solidity ^0.8.20;

/**
 * Poseidon Hasher for ZK-Sentinel
 * Uses precompiled bytecode from circomlibjs
 */
contract Hasher {
    function poseidon(bytes32[2] calldata inputs) external pure returns (bytes32) {
        // Placeholder - real implementation uses circomlibjs generated bytecode
        return keccak256(abi.encodePacked(inputs[0], inputs[1]));
    }
    
    function poseidon3(bytes32[3] calldata inputs) external pure returns (bytes32) {
        return keccak256(abi.encodePacked(inputs[0], inputs[1], inputs[2]));
    }
}
